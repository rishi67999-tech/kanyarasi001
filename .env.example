# ==============================================================================
# AI-POWERED 3D KNOWLEDGE SKELETON - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env or .env.local to configure real AI models and web search providers.
# NOTE: The application operates with zero configuration in Demo Mode using the built-in
# domain knowledge synthesizer and authoritative Wikipedia open knowledge search if keys are omitted!

# ------------------------------------------------------------------------------
# 1. REAL LLM PROVIDER (Server-side Only - Choose ONE or more)
# ------------------------------------------------------------------------------

# Option A: Google Gemini API (Recommended - Free Tier Available)
# Used by /api/generate-lesson to generate rich educational 3D graphs and quizzes.
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Optional: GEMINI_MODEL=gemini-1.5-flash (or gemini-2.0-flash)

# Option B: OpenAI API
# Get your API key from OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
# Optional: OPENAI_MODEL=gpt-4o-mini

# Option C: Groq API (Ultra-fast LLaMA 3.3 inference - Free Tier Available)
# Get your API key from Groq: https://console.groq.com/
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
# Optional: GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 2. WEB SEARCH GROUNDING (Server-side Only - Optional)
# ------------------------------------------------------------------------------
# If left blank, the app automatically falls back to Wikipedia Open STEM Search
# and authoritative technical documentation (docs.python.org, MDN Web Docs, PostgreSQL).

# Option A: Tavily AI Search (Recommended for RAG search)
# Get free 1,000 searches/month: https://tavily.com/
TAVILY_API_KEY=YOUR_TAVILY_API_KEY_HERE

# Option B: Google Serper API
# Get free 2,500 Google searches: https://serper.dev/
SERPER_API_KEY=YOUR_SERPER_API_KEY_HERE

# ------------------------------------------------------------------------------
# 3. SUPABASE CLOUD DATABASE (Client-side - Optional)
# ------------------------------------------------------------------------------
# Used for syncing learning progress and custom saved maps across devices.
# If omitted, all progress is securely stored in browser localStorage.
# Get credentials from your Supabase Project Settings -> API: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
